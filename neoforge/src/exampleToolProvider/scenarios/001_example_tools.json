{"name":"example_tool_provider_tools","tags":["tool-provider-spi"],"requires":{"loaders":["neoforge"]},"steps":[{"id":"title","tool":"mc.condition.wait","args":{"condition":"client.screen != null && client.rawInWorld == false","timeoutMs":120000},"expect":{"result.matched":true}},{"id":"caps","tool":"mc.debug.capabilities","args":{},"expect":{"result.toolProviders":{"contains":"io.izzel.minecraftmcp.example.ExampleToolProvider"}}},{"id":"echo","tool":"example.echo","args":{"x":1},"expect":{"result.echo.x":1}},{"id":"health_title","tool":"example.player_health","args":{},"expect":{"result.inWorld":false}},{"id":"join","tool":"mc.world.join","args":{"name":"minecraft_mcp_spi_world","seed":0,"preset":"flat"},"expect":{"result.status":"joining"}},{"id":"in_world","tool":"mc.condition.wait","args":{"condition":"client.inWorld == true","timeoutMs":60000},"expect":{"result.matched":true}},{"id":"health_world","tool":"example.player_health","args":{},"expect":{"result.inWorld":true,"result.maxHealth":20.0}},{"id":"server_tool","tool":"mc.server.call","args":{"tool":"example.server_state","arguments":{}},"expect":{"result.running":true,"result.dedicated":false,"result.players":1}},{"id":"no_override","tool":"mc.client.state","args":{},"expect":{"result.running":true}},{"id":"leave","tool":"mc.world.leave","args":{},"expect":{"result.status":"left_to_title"}}]}
